# Copy this file to .env.local and fill in values.
# Never commit .env.local — it is gitignored.

# Supabase — from https://supabase.com/dashboard/project/<id>/settings/api
# For local dev, run `npm run supabase:start` and copy the printed values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: custom Mapbox style URL (leave blank to use default street style)
NEXT_PUBLIC_MAPBOX_STYLE_URL=
